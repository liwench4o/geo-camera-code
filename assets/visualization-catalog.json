    {
      "revision": "hexagon-v3",
      "id": "hexagon",
      "title": "Hexagon",
      "datasetId": "road-safety",
      "datasetParam": "hexagonDataset",
      "mapStyle": "carto.darkNoLabels",
      "initialViewState": "ukHexagon",
      "effects": ["ukHexagonLighting"],
      "tooltip": "hexagonCount",
      "layers": [
        {
          "id": "hexagon-layer",
          "type": "HexagonLayer",
          "dataRef": "points",
          "rendererVersion": 1,
          "props": {
            "coverage": {
              "param": "hexagonCoverage"
            },
            "radius": {
              "param": "hexagonRadius"
            },
            "upperPercentile": {
              "param": "hexagonUpperPercentile"
            }
          },
          "accessors": {
            "getPosition": "lonLat",
            "getColorWeight": "constant1",
            "getElevationWeight": "constant1"
          },
          "selection": {
            "supported": ["click"],
            "renderQueryId": "select-hexagon-cell-v1"
          },
          "cameraEnvelope": {
            "producer": "hexagon-cell",
            "producerVersion": 1,
            "positionAccessor": "hexagonSelectionPosition",
            "radius": {
              "param": "hexagonRadius",
              "unit": "meters"
            },
            "coverage": {
              "prop": "coverage"
            },
            "elevation": {
              "valueField": "elevationValue",
              "rangeProp": "elevationRange",
              "scaleProp": "elevationScale",
              "domainProp": "elevationDomain"
            },
            "support": {
              "antialiasBufferPx": 2
            },
            "capabilities": {
              "supportsLive": false,
              "supportsPrediction": false,
              "maxPredictionHorizonMs": 0,
              "nominalUpdateHz": 1,
              "frameEvolution": "revision-step"
            }
          },
          "cameraCalibration": {
            "version": 1,
            "referenceZoom": 8,
            "referenceSafeAreaPx": 921600,
            "metrics": {
              "elevation": {
                "unit": "meters",
                "lo": 10,
                "hi": 10000,
                "source": "global-fallback-v1"
              },
              "density": {
                "unit": "count/km2",
                "lo": 1,
                "hi": 1000,
                "source": "global-fallback-v1"
              },
              "aspect": {
                "unit": "ratio",
                "lo": 1,
                "hi": 8,
                "source": "catalog-v1"
              }
            }
          },
          "analytics": {
            "kind": "hexagon",
            "positionAccessor": "lonLat",
            "radiusParam": "hexagonRadius",
            "weightAccessor": "constant1"
          },
          "onClick": "hexagonPosition"
        }
      ],
      "parameters": [
        {
          "key": "hexagonDataset",
          "label": "Dataset",
          "control": "select",
          "default": "road-safety",
          "options": [
            {
              "label": "UK Road Safety (Personal injury road accidents)",
              "value": "road-safety"
            },
            {
              "label": "San Francisco Bike Parking",
              "value": "bike-parking"
            }
          ]
        },
        {
          "key": "hexagonCoverage",
          "label": "Coverage",
          "control": "slider",
          "default": 1,
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        {
          "key": "hexagonRadius",
          "label": "Radius",
          "control": "slider",
          "default": 1000,
          "min": 500,
          "max": 10000,
          "step": 10
        },
        {
